{
  "info": {
    "name": "SBI Surveillance Dashboard API",
    "description": "Complete API collection for SBI Surveillance Dashboard.\n\n**Auth Flow:**\n1. POST /login (urlencoded) → save `tempToken`\n2. POST /verify-otp (Bearer tempToken) → save `token`\n3. All subsequent requests use Bearer `{{token}}`\n\n**Variables to set before testing:**\n- `baseUrl` — already set to production URL\n- `token` — auto-filled after verify-otp\n- `tempToken` — auto-filled after login\n- `resetToken` — auto-filled after forgot/verify-otp\n- `userId` — set to your users_id",
    "_postman_id": "sbi-surveillance-v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "https://sbi-dashboard.ifiber.in:7668/api", "type": "string" },
    { "key": "token",      "value": "",  "type": "string" },
    { "key": "tempToken",  "value": "",  "type": "string" },
    { "key": "resetToken", "value": "",  "type": "string" },
    { "key": "userId",     "value": "",  "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.tempToken) pm.collectionVariables.set('tempToken', r.tempToken);",
                "if (r.userId) pm.collectionVariables.set('userId', String(r.userId));",
                "pm.test('Login success - got tempToken', () => { pm.response.to.have.status(200); pm.expect(r.tempToken).to.be.a('string'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "EmailId",  "value": "your_email@example.com", "type": "text" },
                { "key": "password", "value": "YourPassword",            "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Step 1: Returns `tempToken` (10-min JWT, OTP not yet verified). Body: x-www-form-urlencoded."
          }
        },
        {
          "name": "2. Verify OTP",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.token) pm.collectionVariables.set('token', r.token);",
                "pm.test('OTP verified - got final token', () => { pm.response.to.have.status(200); pm.expect(r.token).to.be.a('string'); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tempToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/verify-otp", "host": ["{{baseUrl}}"], "path": ["verify-otp"] },
            "description": "Step 2: Send OTP received on registered email. Requires tempToken as Bearer. Saves final token on success."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/logout", "host": ["{{baseUrl}}"], "path": ["logout"] },
            "description": "Blacklists the current JWT. User must login again."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"CurrentPassword@123\",\n  \"newPassword\": \"NewStrongPass@12345\",\n  \"confirmPassword\": \"NewStrongPass@12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/change-password", "host": ["{{baseUrl}}"], "path": ["change-password"] },
            "description": "Password policy: min 15 chars, must include uppercase, lowercase, number, and special character."
          }
        },
        {
          "name": "Get Password Expiry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/password-expiry/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["password-expiry", "{{userId}}"]
            },
            "description": "Returns days remaining before password expires (30-day policy). Set {{userId}} variable."
          }
        }
      ]
    },

    {
      "name": "Forgot Password",
      "item": [
        {
          "name": "1. Check Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/forgot/check-email", "host": ["{{baseUrl}}"], "path": ["forgot", "check-email"] },
            "description": "Check if email is registered before sending OTP. Returns {exists: true/false}."
          }
        },
        {
          "name": "2. Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/forgot/send-otp", "host": ["{{baseUrl}}"], "path": ["forgot", "send-otp"] },
            "description": "Sends OTP to the registered email. OTP valid for 15 min. Rate limited."
          }
        },
        {
          "name": "3. Verify OTP (Forgot)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.resetToken) pm.collectionVariables.set('resetToken', r.resetToken);",
                "pm.test('Reset token received', () => pm.expect(r.resetToken).to.be.a('string'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"user@example.com\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/forgot/verify-otp", "host": ["{{baseUrl}}"], "path": ["forgot", "verify-otp"] },
            "description": "Verify the forgot-password OTP. Returns resetToken on success."
          }
        },
        {
          "name": "4. Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewStrongPass@12345\",\n  \"resetToken\": \"{{resetToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/forgot/reset-password", "host": ["{{baseUrl}}"], "path": ["forgot", "reset-password"] },
            "description": "Reset password using resetToken from step 3. Min 15 chars. Cannot reuse last 5 passwords."
          }
        }
      ]
    },

    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Snapshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard-snapshot?lho_id=25",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard-snapshot"],
              "query": [{ "key": "lho_id", "value": "25", "description": "Optional. Omit to get all LHOs." }]
            },
            "description": "Returns totalLocations, totalOnline, totalOffline, totalPercentage, lhoDetails[]."
          }
        },
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard-summary", "host": ["{{baseUrl}}"], "path": ["dashboard-summary"] },
            "description": "High-level summary of online/offline counts."
          }
        },
        {
          "name": "Dashboard LHO Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard-lho-details", "host": ["{{baseUrl}}"], "path": ["dashboard-lho-details"] },
            "description": "Per-LHO online/offline breakdown from the latest cron snapshot."
          }
        },
        {
          "name": "Dashboard Data (Legacy)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboardData", "host": ["{{baseUrl}}"], "path": ["dashboardData"] },
            "description": "Legacy dashboard data endpoint. Returns totalLocations and lhoDetails[]."
          }
        },
        {
          "name": "LHO List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/lho-list?lho_id=25",
              "host": ["{{baseUrl}}"],
              "path": ["lho-list"],
              "query": [{ "key": "lho_id", "value": "25", "description": "Optional filter." }]
            },
            "description": "Returns LHO list used by the dashboard dropdown."
          }
        },
        {
          "name": "LHO List (Alt)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/lho-list1", "host": ["{{baseUrl}}"], "path": ["lho-list1"] },
            "description": "Returns [{lho_id, lho_name}]."
          }
        },
        {
          "name": "Get LHO List (API)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/getLHOList", "host": ["{{baseUrl}}"], "path": ["api", "getLHOList"] },
            "description": "Returns [{lho_id, lho_name}]. Registered at /api/getLHOList on the server."
          }
        }
      ]
    },

    {
      "name": "Health Check",
      "item": [
        {
          "name": "Live Health Check",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/live-health-check", "host": ["{{baseUrl}}"], "path": ["live-health-check"] },
            "description": "Pings all vendor APIs (BUILDINT, ANIKET, SECURENS, GLOBAL, CTS, ITL, DFS) and returns their live connectivity status."
          }
        },
        {
          "name": "Get ATM Details / Health Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/get-atm-details?lho_id=25",
              "host": ["{{baseUrl}}"],
              "path": ["get-atm-details"],
              "query": [{ "key": "lho_id", "value": "25", "description": "Required. LHO ID for the health report." }]
            },
            "description": "Returns per-ATM health report with ONLINE/OFFLINE status, ageing, and last communication time."
          }
        }
      ]
    },

    {
      "name": "Site Master",
      "item": [
        {
          "name": "Get All Sites",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/sitemaster", "host": ["{{baseUrl}}"], "path": ["api", "sitemaster"] },
            "description": "Returns all active ATM sites with LHO name and vendor name. Response key: 'sites'."
          }
        },
        {
          "name": "Get Site by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/site/1", "host": ["{{baseUrl}}"], "path": ["api", "site", "1"] },
            "description": "Returns a single site record by primary key ID."
          }
        },
        {
          "name": "Add Site",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"atm_latest\": \"NEWSITE001\",\n  \"atm_1\": null,\n  \"atm_2\": null,\n  \"atm_3\": null,\n  \"atm_4\": null,\n  \"atm_5\": null,\n  \"lho_id\": 25,\n  \"vendor\": 4,\n  \"site_address\": \"123 Test Street\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"is_active\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/add-site", "host": ["{{baseUrl}}"], "path": ["add-site"] },
            "description": "Admin only. Adds a new ATM site. Returns {message, id}."
          }
        },
        {
          "name": "Update Site",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"atm_latest\": \"ATMID001\",\n  \"atm_1\": null,\n  \"atm_2\": null,\n  \"atm_3\": null,\n  \"atm_4\": null,\n  \"atm_5\": null,\n  \"lho_id\": 25,\n  \"vendor\": 4,\n  \"site_address\": \"Updated Address\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"is_active\": 1,\n  \"updated_by\": {{userId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/update-site", "host": ["{{baseUrl}}"], "path": ["api", "update-site"] },
            "description": "Required fields: id, atm_latest, lho_id, vendor, site_address, city, state, pincode."
          }
        },
        {
          "name": "Delete Site",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 999,\n  \"deleted_by\": {{userId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/delete-site", "host": ["{{baseUrl}}"], "path": ["api", "delete-site"] },
            "description": "Soft-deletes a site (sets is_deleted=1). Requires id and deleted_by (current user's ID)."
          }
        },
        {
          "name": "Bulk Upload Sites (Excel)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "", "description": "Excel file (.xlsx)" }]
            },
            "url": { "raw": "{{baseUrl}}/api/bulk-upload-sites", "host": ["{{baseUrl}}"], "path": ["api", "bulk-upload-sites"] },
            "description": "Upload Excel file to bulk-insert/update ATM sites."
          }
        },
        {
          "name": "Get ATM List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/atm-list", "host": ["{{baseUrl}}"], "path": ["atm-list"] },
            "description": "Returns all ATM IDs (atm_latest, atm_1..atm_5) from atm_list_new3."
          }
        },
        {
          "name": "Get Vendors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/vendors", "host": ["{{baseUrl}}"], "path": ["vendors"] },
            "description": "Returns [{vendor_id, vendor_name}]. IDs: 1=Aniket, 3=Securens, 4=BUILDINT, 6=Global, 7=CTS."
          }
        },
        {
          "name": "Get ATM Vendor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"atmId\": \"ATMID001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/atm-vendor", "host": ["{{baseUrl}}"], "path": ["atm-vendor"] },
            "description": "Returns vendor ID for a given ATM ID. Response: {vendor: 1}."
          }
        }
      ]
    },

