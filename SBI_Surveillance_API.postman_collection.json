            "url": { "raw": "{{baseUrl}}/buildintSites", "host": ["{{baseUrl}}"], "path": ["buildintSites"] },
            "description": "Fetches site list from BuildINT external API. May return 500 if external API is unreachable."
          }
        }
      ]
    },

    {
      "name": "User Management",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"First\",\n  \"last_name\": \"Last\",\n  \"email_id\": \"newuser@example.com\",\n  \"contact\": \"9999999999\",\n  \"role_id\": 3,\n  \"lho_id\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] },
            "description": "Admin only. Password is auto-generated and emailed. role_id: 1=Admin, 2=SubAdmin, 3=User."
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Returns all users. Admin sees all, SubAdmin sees limited."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Returns a single user record by users_id."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "userid",        "value": "{{userId}}", "description": "Required: ID of the user making the request." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"First\",\n  \"last_name\": \"Last\",\n  \"email_id\": \"user@example.com\",\n  \"contact\": \"9999999999\",\n  \"role_id\": 1,\n  \"is_active\": 1,\n  \"lho_id\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Update user profile. Requires 'userid' custom header (current user's ID). All fields are required."
          }
        },
        {
          "name": "Unlock User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/unlock/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", "unlock", ":id"]
            },
            "description": "Admin only. Resets login_attempts to 0, unlocking a locked account. Replace :id with users_id."
          }
        },
        {
          "name": "Get Roles (with IDs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] },
            "description": "Returns [{role_id, role_name}]. IDs: 1=Admin, 2=SubAdmin, 3=User."
          }
        },
        {
          "name": "Get Role Names",
